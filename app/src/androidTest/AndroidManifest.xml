<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="dev.qingframe" /></queries>
    <application>
        <activity android:name="dev.qingframe.testprobe.ShareProbeActivity"
            android:exported="true" android:process=":shareprobe"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <provider android:name="dev.qingframe.testprobe.SyntheticShareProvider"
            android:authorities="dev.qingframe.test.fixture"
            android:exported="false" android:grantUriPermissions="true"
            android:process=":shareprobe" />
        <activity android:name="dev.qingframe.testprobe.ReceiveProbeActivity"
            android:label="QF Test Receiver" android:exported="true" android:process=":receiverprobe"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter><action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" /><data android:mimeType="image/png" />
            </intent-filter>
        </activity>
    </application>
</manifest>
